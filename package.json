{
  "name": "oortrip-ai-root",
  "version": "1.0.0",
  "private": true,
  "description": "OorTrip AI - Discover Tamil Nadu. Your Journey, Intelligently Planned.",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npx tsx server/src/index.ts",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
